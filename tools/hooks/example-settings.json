{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${VIBECRAFTED_ROOT:-$HOME/.local/share/vibecrafted/tools/vibecrafted-current}/runtime/scripts/vibecrafted-recall.sh",
            "timeout": 90
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/memory-context-loader.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${VIBECRAFTED_ROOT:-$HOME/.local/share/vibecrafted/tools/vibecrafted-current}/runtime/scripts/vibecrafted-precompact.sh",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${VIBECRAFTED_ROOT:-$HOME/.local/share/vibecrafted/tools/vibecrafted-current}/runtime/scripts/vibecrafted-precompact.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${VIBECRAFTED_ROOT:-$HOME/.local/share/vibecrafted/tools/vibecrafted-current}/runtime/scripts/vibecrafted-postcompact.sh",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${VIBECRAFTED_ROOT:-$HOME/.local/share/vibecrafted/tools/vibecrafted-current}/runtime/scripts/vibecrafted-postcompact.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/loct-grep-augment.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/loct-grep-augment.sh --bash-filter"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "(?i)(zapami[eę]taj|remember|na stałe|raz na zawsze)",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/memory-on-explicit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/memory-on-ultrathink.sh"
          }
        ]
      }
    ]
  }
}
