<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- nosemgrep: swift.insecure-communication.ats.ats-pinning.ATS-consider-pinning -- The caretaker selects the local/Tailscale HTTP endpoint. NSAllowsLocalNetworking is the narrow ATS declaration required for IP-literal local networking on macOS 14+; WebKit navigation is confined by WebNavigationPolicy and system TLS validation remains enabled. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>Vibecrafted.icns</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- nosemgrep: swift.insecure-communication.ats.ats-local.ATS-local-networking -- Required for the caretaker-selected loopback or Tailscale IP-literal HTTP runtime. Apple documents NSAllowsLocalNetworking as the narrow macOS 14+ ATS declaration for local IP resources; WebNavigationPolicy admits HTTP only for that exact resolved origin. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSQuitAlwaysKeepsWindows</key>
	<false/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>io.vetcoders.vibecrafted.run</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vibecrafted</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
