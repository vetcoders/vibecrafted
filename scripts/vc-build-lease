#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$SCRIPT_DIR/project-python" -c \
  'import sys; sys.path.insert(0,sys.argv.pop(1)); from vibecrafted_core.cache_lifecycle import main; raise SystemExit(main())' \
  "$SCRIPT_DIR/../vibecrafted-core" "$@"
