    "$crafted_tools/vibecrafted-core/vibecrafted_core/runtime/scripts/vibecrafted-loop.sh" \
    "$(_script_repo_root)/vibecrafted-core/vibecrafted_core/runtime/scripts/vibecrafted-loop.sh"; do
    [[ -n "$candidate" && -f "$candidate" ]] || continue
    printf '%s\n' "$candidate"
