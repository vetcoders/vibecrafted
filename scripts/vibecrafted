cmd_resume_help() {
  printf '\n'
  printf '%b⚒%b  %bresume%b\n' "$_copper" "$_reset" "$_bold" "$_reset"
  printf '%b─────────────────────────────────────────%b\n' "$_steel" "$_reset"
  printf '  Resume a stopped control-plane run, a provider session, or AICX continuity.\n'
  printf '\n'
  printf '%bUsage:%b\n' "$_bold" "$_reset"
  printf '  vibecrafted resume <claude|codex|agy|junie|grok> --run-id <work-...> [flags]\n'
  printf '  vibecrafted resume <claude|codex|agy|junie|grok> --session <provider-uuid> [flags]\n'
  printf '  vibecrafted resume <claude|codex|agy|junie|grok> [flags]\n'
  printf '\n'
  printf '%bAfter stop:%b\n' "$_bold" "$_reset"
  printf '  Stop kills the process group. There is no same-PGID restart.\n'
  printf '  --run-id launches a NEW tracked job that continues the stopped work.\n'
  printf '  If the run recorded a provider session, that session is resumed natively.\n'
  printf '  Do not put VIBECRAFTED_SESSION_ID or work-* into --session.\n'
  printf '\n'
  printf '%bWithout --run-id / --session:%b\n' "$_bold" "$_reset"
  printf '  Builds a bounded continuity pack from the AICX session chain.\n'
  printf '  A bare resume stays interactive; the AICX pack is continuity transport,\n'
  printf '  not operator job text and not a native attach. Never resumes the last\n'
  printf '  same-agent match. Native provider resume requires --session <id>.\n'
  printf '  --root / a project filter narrows AICX; it does not pick an id.\n'
  printf '  The session catalog in the pack is evidence, not a swipe list.\n'
  printf '  Explicit --prompt/--file without --session starts a new tracked\n'
  printf '  headless job and does not adopt a historical session.\n'
  printf '  Override window: VIBECRAFTED_RESUME_AICX_HOURS=72\n'
  printf '\n'
  printf '%bExamples:%b\n' "$_bold" "$_reset"
  printf '  vibecrafted resume claude --run-id work-260816-213657-08420\n'
  printf '  vibecrafted resume claude --run-id work-260816-213657-08420 --prompt "continue"\n'
  printf '  vibecrafted resume claude --last\n'
  printf '  vibecrafted resume claude --session abc123\n'
  printf '  vibecrafted resume codex --session abc123 --prompt "Continue from the failing test"\n'
  printf '  vibecrafted resume grok\n'
  printf '  vibecrafted resume codex --prompt "pick up where the fleet left off"\n'
  printf '\n'
  _print_skill_specific_flags "resume"
  printf '\n'
}

cmd_init_help() {
  printf '\n'
  printf '%b⚒%b  %binit%b\n' "$_copper" "$_reset" "$_bold" "$_reset"
  printf '%b─────────────────────────────────────────%b\n' "$_steel" "$_reset"
  printf '  Start an interactive repository orientation session with an agent.\n'
  printf '\n'
  printf '%bUsage:%b\n' "$_bold" "$_reset"
  printf '  vibecrafted init [claude|codex|agy|junie|grok] [--runtime terminal|visible|plain] [--policy-runtime local-native|local-worktrees|local-vm|cloud-soon] [--permissions bypass|auto|accept-edits|read-only] [--token-budget safe|unlimited|N] [--continuity full-lineage|fresh|bare-fork] [--prompt "<context>"]\n'
  printf '  vc-init [claude|codex|agy|junie|grok]\n'
  printf '\n'
  printf '%bRuntime:%b\n' "$_bold" "$_reset"
  printf '  terminal  (default) open a tab in the vc-frame cockpit; falls back to plain when vc-frame is absent\n'
  printf '  plain     start the agent in this terminal, no cockpit needed\n'
  printf '  Policy runtime defaults to local-native; unavailable runtimes fail closed.\n'
  printf '  Permission support is provider-specific; unsupported cells are rejected.\n'
  printf '  Token budget defaults to safe (250000 measured tokens); N sets a bounded budget.\n'
  printf '  unlimited is restricted to directly observed local-native sessions and still measures usage.\n'
  printf '  Measured quota currently requires a verified Claude transcript capability; unsupported providers fail closed.\n'
  printf '  Continuity defaults to fresh in the shell. full-lineage requires materialized AICX + active LOOP + parent lineage.\n'
  printf '  bare-fork is expert-only and requires --parent-session <exact-provider-session-id>.\n'
  printf '\n'
  printf '%bExamples:%b\n' "$_bold" "$_reset"
  printf '  vibecrafted init claude\n'
  printf '  vibecrafted init claude --runtime plain\n'
  printf '  vibecrafted init claude --runtime plain --policy-runtime local-native --permissions accept-edits\n'
  printf '  vibecrafted init claude --continuity full-lineage --continuity-parent <run-id>\n'
  printf '  vc-init codex\n'
  printf '\n'
}

