# config/memex.toml.example — Plan 09 (META_22)
#
# Memex cross-session retrieval client configuration: the [memex] table of
# the one operator config, ${XDG_CONFIG_HOME:-~/.config}/vibecrafted/config.toml
# (the same file that holds [server]). Paste the table below into that file
# and edit. Nothing else is read for memex settings.
#
# A token makes that file a secret: keep it at mode 0600 (chmod 600) and never
# commit a real token to source control. MEMEX_TOKEN in the environment fills
# a token left empty here.
#
# This is OPT-IN. Without the table (or the matching env vars) the memex
# client stays disabled and /vc-init Sense 1 fallthrough is a no-op.
# Vibecrafted works without memex; memex enriches agent perception when
# present.
#
# See docs/MEMEX.md for the operator guide.

[memex]

# Memex endpoint. Point this at your memex host. Adjust to your
# deployment; the trailing slash is stripped.
endpoint = "http://memex.local:11211"

# Bearer token issued by the memex namespace operator. Treat as a
# secret — rotate on suspected compromise. The MCP bridge
# `mcp__rust-memex__namespace_create_token` mints scoped tokens.
token = ""

# Default namespace used when search() is called without an explicit
# `namespace=` argument. Typical pattern: per-project (e.g. "vibecrafted",
# "sample-portal") or per-machine ("host-a", "host-b").
default_namespace = "local"

# HTTP request timeout. Memex lives on your private network so latency is low;
# the default of 5s is generous. Lower it for tighter shells in CI.
timeout_seconds = 5.0

# 𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. with AI Agents by Vetcoders (c)2024-2026 LibraxisAI
