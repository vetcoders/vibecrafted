// Vibecrafted vc-frame Configuration
// Branded terminal multiplexer configuration for the Vibecrafted framework.
// Vibecrafted with AI Agents (c)2026 Vetcoders

// ─── Theme ──────────────────────────────────────────────────────────────────────
// Colors built around a dark base with amber/gold accents (craft)
// and cyan (technology). Contrast stays readable in all conditions.
themes {
    vibecrafted {
        fg 220 215 186         // warm cream — primary text
        bg 30 30 36            // graphite — session background
        black 20 20 24         // deep night — pane borders
        white 235 230 210      // parchment — bright text
        red 204 36 29          // alert red — errors, close actions
        green 142 192 124      // sage green — success, healthy gates
        yellow 214 175 54      // amber gold — brand accent, active tabs
        blue 69 133 136        // steel teal — secondary info
        magenta 177 98 134     // muted rose — session mode indicator
        orange 214 93 14       // deep orange — warnings, in-progress
        cyan 104 157 106       // forest cyan — agent panes, monitoring
    }
}

// Plan 12 (META_22) — mesh-aware host theming.
//
// Additional themes are loaded from `themes/vetcoders-mesh.kdl` in this
// same config dir (vc-frame auto-discovers nested theme blocks). Four accent
// variants so an operator can tell workstations apart:
//
//   mesh-red     — red accent
//   mesh-purple  — purple accent
//   mesh-cyan    — cyan accent
//   mesh-green   — green accent
//   vibecrafted  — neutral default (this file)
//
// Which host gets which accent is configured in `~/.vibecrafted/mesh.conf`
// (`host theme` per line) or via `VIBECRAFTED_MESH_MAP=host-a=mesh-red,...`.
// To switch theme per host, run `./config/vc-frame/auto-theme.sh` which emits
// the matching theme name. Wire it into your shell init, e.g.:
//
//   export VIBECRAFTED_VC_FRAME_THEME="$(./auto-theme.sh)"
//
// Then either override `theme "..."` below or pass via overlay config.
// Fleet chrome — two eyes, one standard shape (flat tiles, no  triangles):
//
//   dark  → monochrome        (bundled in vc-frame assets)
//   light → vibecrafted-ivory (themes/vibecrafted-ivory.kdl — kość słoniowa)
//
// theme_dark + theme_light both required for host-terminal auto-switch
// (CSI 2031). Static `theme` is the fallback when the terminal does not
// report a palette. Brand block "vibecrafted" (graphite + amber) and mesh
// themes remain for explicit override / host identity.
theme "monochrome"
theme_dark "monochrome"
theme_light "vibecrafted-ivory"
// Flat status-bar / tab-bar: no powerline arrow fonts (). Plugins paint
// plain Ctrl+<key> LABEL tiles instead of triangular ribbon buttons.
simplified_ui true

// ─── Shell & Display ────────────────────────────────────────────────────────────
default_shell "zsh"
// compact chowal rail SESSIONS z nowego default.kdl (2026-07-07)
// 2026-07-20: default = wbudowany "vibecrafted" (operator layout z railem,
// Guide + vibecrafted tabs) — zrzut zywego "Vibecrafted Operator"
default_layout "vibecrafted"
copy_command "pbcopy"
mouse_mode true
// Rail hover chrome. Defaults in vc-frame are already true; pin so product
// surface does not drift. With these on, UpdateHover delivers Mouse::Hover to
// the unfocused SESSIONS rail (and clears on leave) — no focus_follows_mouse.
advanced_mouse_actions true
mouse_hover_effects true
pane_frames true
scroll_buffer_size 50000
styled_underlines false
auto_layout true
show_startup_tips false
show_release_notes false
// Key-contract v3 (doctrine 2026-07-30, 8a0f14e65): the global Super/Cmd
// switcher (bind "Super Left/Right/Up/Down", "Super e") is wired as kitty
// CSI-u sequences — the Alacritty preset encodes Cmd+arrows/Cmd+E that way,
// and zellij-client's KittyKeyboardParser only runs when this is on. Plain
// Ctrl chords below stay unaffected either way (Ctrl+Shift+<letter> is not
// used — Ctrl+x / Ctrl+Shift+x would collide without this protocol, but we
// never bind that combo). Leaving this false silently strands the Super
// switcher: it degrades to raw escape-sequence passthrough in every pane.
support_kitty_keyboard_protocol true

// ─── Session Resilience ─────────────────────────────────────────────────────────
// The session survives terminal closure by detaching instead of killing.
// Serialization allows resurrection after restart.
on_force_close "detach"
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 5000

// ─── Plugin Aliases ─────────────────────────────────────────────────────────────
plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    strider location="zellij:strider" {
        pane_title "Files"
    }
    filepicker location="zellij:strider" {
        cwd "/"
        pane_title "Files"
    }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    about location="zellij:about"
}

// ─── Keybindings ────────────────────────────────────────────────────────────────
// Two layers (product key-contract v3):
//   1. Super/Cmd — global switcher + Composer. Lives in `shared` so it works
//      even under LOCK. Requires support_kitty_keyboard_protocol true (above)
//      and a host terminal that emits CSI-u Super (Alacritty preset ships it).
//   2. Plain Ctrl — mode switches + in-mode muscle memory. Works on any terminal.
//
// The Alt layer is left unbound so macOS Option still types Polish diacritics
// (ź, ó, ł, ż, ć, ń …) instead of triggering vc-frame actions.
//
// History: comments used to *promise* Super binds while the body only shipped
// plain Ctrl — install then projected that hollow promise to frontier, and
// Cmd chords silently did nothing. Super binds are first-class here.
keybinds {
    // Super/Cmd switcher — alive in EVERY mode including LOCK (Super never
    // collides with pane input). Must stay in `shared`, not shared_except.
    shared {
        unbind "Ctrl q"
        bind "Super Left" { GoToPreviousTab; }
        bind "Super Right" { GoToNextTab; }
        bind "Super Up" {
            MessagePlugin "session-rail" {
                name "vc_rail_nav"
                payload "up"
            };
        }
        bind "Super Down" {
            MessagePlugin "session-rail" {
                name "vc_rail_nav"
                payload "down"
            };
        }
        // Command Composer (spec 1.2 §A): Super+e / Cmd+E. Alt+e unbound so
        // macOS Option types Polish `ę`. Uses the one installed product config.
        bind "Super e" {
            Run "sh" "-c" "if [ -x \"${XDG_CONFIG_HOME:-$HOME/.config}/vibecrafted/vc-frame/vc-composer.sh\" ]; then \"${XDG_CONFIG_HOME:-$HOME/.config}/vibecrafted/vc-frame/vc-composer.sh\"; else f=$(mktemp \"${TMPDIR:-/tmp}/vc-composer.XXXXXX\") || exit 1; ${EDITOR:-vim} -c 'set number' -c 'set laststatus=0' -c 'set nowrap' -c 'set textwidth=0' -c 'set sidescroll=1' -c 'nnoremap <silent> <F2> :set wrap! wrap?<CR>' \"$f\"; if [ -s \"$f\" ]; then vc-frame action toggle-floating-panes; vc-frame action write-chars \"$(cat \"$f\")\"; fi; rm -f -- \"$f\"; fi" {
                floating true
                close_on_exit true
                name "✍ Composer · ⧉ Paste stack"
            }
        }
    }

    shared_except "locked" {
        // Free the Alt layer for Polish diacritics.
        unbind "Alt f" "Alt n" "Alt i" "Alt o"
        unbind "Alt h" "Alt Left" "Alt l" "Alt Right"
        unbind "Alt j" "Alt Down" "Alt k" "Alt Up"
        unbind "Alt =" "Alt +" "Alt -" "Alt [" "Alt ]"
        unbind "Alt p" "Alt Shift p"

        // Direct new-pane on plain Ctrl+n (overrides the default resize-mode
        // entry; resize is re-bound inside pane mode below — +/=/- uniform,
        // Shift+H/J/K/L directional).
        bind "Ctrl n" { NewPane; }

        // Unlocked muscle-memory lane: Ctrl+arrows mirror the Super switcher
        // outside LOCK. In LOCK they pass through to the pane.
        bind "Ctrl Left" { GoToPreviousTab; }
        bind "Ctrl Right" { GoToNextTab; }
        bind "Ctrl Up" {
            MessagePlugin "session-rail" {
                name "vc_rail_nav"
                payload "up"
            };
        }
        bind "Ctrl Down" {
            MessagePlugin "session-rail" {
                name "vc_rail_nav"
                payload "down"
            };
        }

        // Ctrl+Q = close the focused PANE, never quit the session.
        bind "Ctrl q" { CloseFocus; SwitchToMode "Normal"; }
    }

    // Copy the *other* focused pane's full scrollback to the clipboard.
    // Was Ctrl+Shift+c (dead without CSI-u); relocated to pane mode as 'y' (yank).
    pane {
        bind "y" {
            Run "bash" "-lc" "${XDG_CONFIG_HOME:-$HOME/.config}/vibecrafted/vc-frame/copy-scrollback.sh" {
                close_on_exit true
                floating true
                name "copy-pane-scrollback"
            };
            SwitchToMode "Normal";
        }

        // Pane resize from inside pane mode (Ctrl+p). Plain chars only — no
        // Ctrl/Alt chord, so no kitty-keyboard protocol is needed and the Alt
        // diacritics layer stays free. Default pane-mode h/j/k/l already MOVE
        // focus; Shift+H/J/K/L resize directionally (grow toward that edge),
        // +/=/- resize uniformly. Stays in pane mode so repeated resizes need
        // no re-entry (Esc/Enter returns to Normal).
        bind "+" "=" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "H" { Resize "Increase Left"; }
        bind "J" { Resize "Increase Down"; }
        bind "K" { Resize "Increase Up"; }
        bind "L" { Resize "Increase Right"; }
    }

    // Explicit quit lives on Ctrl+o (SESSION) then 'q', since Ctrl+q now only
    // ever closes a pane. (Normal full-quit path = close the last pane.)
    session {
        bind "q" { Quit; }
    }

    // ─── Tab mode (Ctrl+t): spatial navigation ──────────────────────────────
    // ←/→ walk the TOP tab bar; ↑/↓ walk the LEFT Sessions rail. Target
    // plugin alias is "session-rail" as expected by the vc-frame contract.
    tab {
        bind "h" "Left" { GoToPreviousTab; }
        bind "l" "Right" { GoToNextTab; }
        bind "k" "Up" {
            MessagePlugin "session-rail" {
                name "vc_rail_nav"
                payload "up"
            };
        }
        bind "j" "Down" {
            MessagePlugin "session-rail" {
                name "vc_rail_nav"
                payload "down"
            };
        }
    }

    // ─── Copy mode (inside Ctrl+s SCROLL) ───────────────────────────────────
    // vc-frame has no keyboard text-region selection — `Copy` only copies a
    // mouse-made selection, useless without a mouse. The mouseless copy path
    // is: scroll/search to find what you want, then 'y' to yank the focused
    // pane's FULL scrollback to the clipboard (pbcopy). Same proven dump+pbcopy
    // pattern as pane-mode 'y', reachable from the scroll/search mode where
    // copy muscle-memory lives. Scroll/search/edit defaults are untouched (this
    // block merges into the built-in scroll mode).
    scroll {
        bind "y" {
            Run "bash" "-lc" "${XDG_CONFIG_HOME:-$HOME/.config}/vibecrafted/vc-frame/copy-scrollback.sh" {
                close_on_exit true
                floating true
                name "copy-scrollback"
            };
            SwitchToMode "Normal";
        }
    }
}
