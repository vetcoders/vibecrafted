#!/usr/bin/env bash
# Exec a vc-frame pane Python script with the Runtime Pack interpreter.
# Host `env python3` (Homebrew) does not import vibecrafted_core.
set -euo pipefail

launcher="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

if [[ -z "$launcher" || ! -x "$launcher" ]]; then
  printf '\n  Pane launcher missing: %s\n  Repair: run make install from the Vibecrafted checkout with your verified Runtime Pack\n\n' "${launcher:-<none>}" >&2
  exec "${SHELL:-/bin/zsh}" -l
fi

# Same candidate order as spawn_python_bin (meta.sh). vc-frame bash -lc panes
# do not inherit the deck wrapper; Homebrew python3 cannot import core.
data="${XDG_DATA_HOME:-$HOME/.local/share}"
candidates=(
  "${VIBECRAFTED_PYTHON:-}"
  "${VIBECRAFTED_RUNTIME_ROOT:+${VIBECRAFTED_RUNTIME_ROOT}/bin/python3}"
  "${VIBECRAFTED_ROOT:+${VIBECRAFTED_ROOT}/bin/python3}"
  "$data/uv/tools/vibecrafted/bin/python3"
  "$data/uv/tools/vibecrafted/bin/python"
  "$data/uv/tools/vibecrafted-core/bin/python3"
  "$data/vibecrafted/tools/vibecrafted-current/bin/python3"
)
for py in "${candidates[@]}"; do
  [[ -n "$py" && -x "$py" ]] || continue
  # shellcheck disable=SC2093  # This wrapper intentionally becomes the selected interpreter.
  exec "$py" "$launcher" "$@"
done
exec "$launcher" "$@"
