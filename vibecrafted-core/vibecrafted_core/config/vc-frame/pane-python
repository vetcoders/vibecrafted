#!/usr/bin/env bash
# Exec a vc-frame pane Python script with the Runtime Pack interpreter.
# Host `env python3` (Homebrew) does not import vibecrafted_core.
set -euo pipefail

launcher="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

if [[ -z "$launcher" || ! -x "$launcher" ]]; then
  printf '\n  Pane launcher missing: %s\n  Repair: run make install from the Vibecrafted checkout with your verified Runtime Pack\n\n' "${launcher:-<none>}" >&2
  exec "${SHELL:-/bin/zsh}" -l
fi

# The pane runs the runtime's pinned interpreter by absolute path: the pin the
# Frame server inherited from its entry, else the selected generation's own
# bin/python3. Never the uv-tool venv, the active-generation pointer or a PATH
# python: a pane that quietly ran another interpreter would hide the broken
# pin until the first import that needs 3.11+.
candidates=(
  "${VIBECRAFTED_PYTHON:-}"
  "${VIBECRAFTED_RUNTIME_ROOT:+${VIBECRAFTED_RUNTIME_ROOT}/bin/python3}"
  "${VIBECRAFTED_ROOT:+${VIBECRAFTED_ROOT}/bin/python3}"
)
for py in "${candidates[@]}"; do
  [[ "$py" == /* && -x "$py" && ! -d "$py" ]] || continue
  # This wrapper intentionally becomes the selected interpreter.
  # shellcheck disable=SC2093
  exec "$py" "$launcher" "$@"
done
printf '\n  No runtime interpreter pinned for this pane (VIBECRAFTED_PYTHON / VIBECRAFTED_RUNTIME_ROOT unset or not executable).\n  Repair: reopen the workspace from Vibecrafted (vc-start) so the Frame server carries its runtime pin.\n\n' >&2
exec "${SHELL:-/bin/zsh}" -l
