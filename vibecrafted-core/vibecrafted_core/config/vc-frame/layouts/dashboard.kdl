// dashboard — mission control overview
// Launch: vibecrafted dashboard | vibecrafted dashboard dashboard
//
// Design: pure monitoring surface — no work pane. Four quadrants showing
// live system state. Agent tabs spawned during monitoring sessions get
// branded chrome via new_tab_template.
//
// Swap layouts:
//   "default"  — 2x2 grid (balanced monitoring)
//   "stacked"  — vertical stack (narrow terminals)
//   "focused"  — single large pane + compact sidebar
//
// Vibecrafted with AI Agents (c)2026 Vetcoders
layout {
    // new_tab_template removed: vc-frame 0.44 broke `children` inside it.
    // default_tab_template covers both existing and new tabs.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="compact-bar" {
                // 🚥 zone: clear the macOS traffic lights in the native window
                left_inset "6"
            }
        }
        pane split_direction="vertical" {
            pane size=24 borderless=true {
                plugin location="session-manager" {
                    rail true
                    pane_title "Sessions"
                }
            }
            pane { children; }
        }
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. MC" {
        pane split_direction="horizontal" {
            pane split_direction="vertical" size="50%" {
                pane name="agents" focus=true command="bash" start_suspended=false {
                    args "-lc" "for root in \"${VIBECRAFTED_RUNTIME_ROOT:+$VIBECRAFTED_RUNTIME_ROOT/vibecrafted-core/vibecrafted_core/runtime}\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/vibecrafted-core/vibecrafted_core/runtime}\" \"${VIBECRAFTED_HOME:-$HOME/.vibecrafted}/runtime\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/.vibecrafted/runtime}\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/runtime}\" \"./runtime\"; do for mc in \"$root/vc-operator/mission-control/active-agents.sh\" \"$root/scripts/mission-control/active-agents.sh\"; do if [[ -n \"$root\" && -x \"$mc\" ]]; then exec \"$mc\"; fi; done; done; printf 'Mission control helper not found: active-agents.sh\\n'; exec /bin/zsh -l"
                }
                pane name="transcript" command="bash" start_suspended=false {
                    args "-lc" "for root in \"${VIBECRAFTED_RUNTIME_ROOT:+$VIBECRAFTED_RUNTIME_ROOT/vibecrafted-core/vibecrafted_core/runtime}\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/vibecrafted-core/vibecrafted_core/runtime}\" \"${VIBECRAFTED_HOME:-$HOME/.vibecrafted}/runtime\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/.vibecrafted/runtime}\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/runtime}\" \"./runtime\"; do for mc in \"$root/vc-operator/mission-control/live-transcript.sh\" \"$root/scripts/mission-control/live-transcript.sh\"; do if [[ -n \"$root\" && -x \"$mc\" ]]; then exec \"$mc\"; fi; done; done; printf 'Mission control helper not found: live-transcript.sh\\n'; exec /bin/zsh -l"
                }
            }
            pane split_direction="vertical" size="50%" {
                pane name="convergence" command="bash" start_suspended=false {
                    args "-lc" "for root in \"${VIBECRAFTED_RUNTIME_ROOT:+$VIBECRAFTED_RUNTIME_ROOT/vibecrafted-core/vibecrafted_core/runtime}\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/vibecrafted-core/vibecrafted_core/runtime}\" \"${VIBECRAFTED_HOME:-$HOME/.vibecrafted}/runtime\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/.vibecrafted/runtime}\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/runtime}\" \"./runtime\"; do for mc in \"$root/vc-operator/mission-control/convergence-trend.sh\" \"$root/scripts/mission-control/convergence-trend.sh\"; do if [[ -n \"$root\" && -x \"$mc\" ]]; then exec \"$mc\"; fi; done; done; printf 'Mission control helper not found: convergence-trend.sh\\n'; exec /bin/zsh -l"
                }
                pane name="sessions" command="bash" start_suspended=false {
                    args "-lc" "for root in \"${VIBECRAFTED_RUNTIME_ROOT:+$VIBECRAFTED_RUNTIME_ROOT/vibecrafted-core/vibecrafted_core/runtime}\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/vibecrafted-core/vibecrafted_core/runtime}\" \"${VIBECRAFTED_HOME:-$HOME/.vibecrafted}/runtime\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/.vibecrafted/runtime}\" \"${VIBECRAFTED_ROOT:+$VIBECRAFTED_ROOT/runtime}\" \"./runtime\"; do for mc in \"$root/vc-operator/mission-control/recent-sessions.sh\" \"$root/scripts/mission-control/recent-sessions.sh\"; do if [[ -n \"$root\" && -x \"$mc\" ]]; then exec \"$mc\"; fi; done; done; printf 'Mission control helper not found: recent-sessions.sh\\n'; exec /bin/zsh -l"
                }
            }
        }
    }

    // Swap: vertical stack for narrow terminals
    swap_tiled_layout name="stacked" {
        tab {
            pane split_direction="horizontal" {
                pane name="agents" size="25%" focus=true
                pane name="transcript" size="25%"
                pane name="convergence" size="25%"
                pane name="sessions" size="25%"
            }
        }
    }

    // Swap: focused — one big pane + compact sidebar
    swap_tiled_layout name="focused" {
        tab {
            pane split_direction="vertical" {
                pane name="agents" size="60%" focus=true
                pane split_direction="horizontal" size="40%" {
                    pane name="transcript"
                    pane name="convergence"
                    pane name="sessions"
                }
            }
        }
    }
}
