// host — first product session. Product projection of vc-frame's
// vibecrafted-host.kdl. The host owns chrome once; workspaces open as
// guests (`--guest-workspace`) so the Sessions rail switches through
// activate_session_request instead of a client detach/reattach.
//
// Path kept as host.kdl for: default_layout "host" in config.kdl.
// Start here / Agents / Shell / voc stay on operator.kdl (guest content).
//
// 𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. with AI Agents by Vetcoders (c)2024-2026 LibraxisAI
layout {
    session_layer {
        pane size=1 borderless=true {
            plugin location="compact-bar" {
                session_canvas true
                session_canvas_kind "compact-bar"
                brand_text " 𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. "
                // 🚥 zone: clear the macOS traffic lights in the native window
                left_inset "6"
            }
        }
        pane split_direction="vertical" {
            pane size=24 borderless=true {
                plugin location="frame-host" {
                    session_canvas true
                    session_canvas_kind "session-manager"
                    rail true
                    frame_host true
                    pane_title "Sessions"
                }
            }
            pane { children; }
        }
        pane size=1 borderless=true {
            plugin location="status-bar" {
                session_canvas true
                session_canvas_kind "status-bar"
            }
        }
    }

    // Content-only. The parser mounts this inside session_layer without
    // copying chrome ownership into the tab contract.
    default_tab_template {
        pane { children; }
    }

    tab name="Workspace" focus=true {
        pane name="VC Guest" {
            plugin location="session-manager" { workspace_surface true; }
        }
    }
}
