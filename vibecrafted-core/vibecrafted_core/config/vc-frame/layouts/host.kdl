// host — first product session. Product projection of vc-frame's
// vibecrafted-host.kdl. The host owns chrome once; workspaces open as
// guests (`--guest-workspace`) so the Sessions rail switches through
// activate_session_request instead of a client detach/reattach.
//
// Path kept as host.kdl for: default_layout "host" in config.kdl.
// Start here / Agents / Shell / Voc stay on operator.kdl (guest content).
//
// 𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. with AI Agents by Vetcoders (c)2024-2026 LibraxisAI
layout {
    session_layer {
        pane size=1 borderless=true {
            plugin location="compact-bar" {
                session_canvas true
                session_canvas_kind "compact-bar"
                brand_text " 𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. "
                // 🚥 zone: clear the macOS traffic lights in the native window
                left_inset "6"
            }
        }
        pane { children; }
        pane size=1 borderless=true {
            plugin location="status-bar" {
                session_canvas true
                session_canvas_kind "status-bar"
            }
        }
    }

    // Every host tab mounts a mirror Sessions rail (INWARIANT #0: host chrome
    // is permanent). A mirror renders the rail but executes nothing locally —
    // each click pipes the owner's command through the fail-closed
    // guest-surface route (session-manager host_mirror support shipped in
    // frame d81af6c4). Workspace opts out via the rail-less workspace-tab
    // template below and stays the sole projection owner.
    default_tab_template {
        pane split_direction="vertical" {
            pane size=24 borderless=true {
                plugin location="session-manager" {
                    rail true
                    host_mirror true
                    pane_title "Sessions"
                }
            }
            pane { children; }
        }
    }

    tab_template name="workspace-tab" {
        pane { children; }
    }

    // Host landing carries intent, not a generation path or the creator's cwd.
    // Keep the guest projection anchor below: Frame requires a plugin surface
    // beside its exclusive frame_host owner to project an existing guest.
    tab name="Home" focus=true {
        pane name="Dashboard" command="vc-o" start_suspended=false {
            args "--view" "host"
        }
    }

    // session_layer is mounted into every tab. Keep the exclusive frame host
    // beside its single workspace surface so Screen sees exactly one owner.
    workspace-tab name="Workspace" {
        pane split_direction="vertical" {
            pane size=24 borderless=true {
                plugin location="frame-host" {
                    session_canvas true
                    session_canvas_kind "session-manager"
                    rail true
                    frame_host true
                    pane_title "Sessions"
                }
            }
            pane name="VC Guest" {
                plugin location="session-manager" { workspace_surface true; }
            }
        }
    }
}
