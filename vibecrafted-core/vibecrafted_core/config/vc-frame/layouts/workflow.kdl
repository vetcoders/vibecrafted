// workflow — ERi implementation workspace
// Launch: vibecrafted dashboard workflow
//
// Design: operator-first. Main pane gets 75% width for focused implementation.
// Agent sidebar is compact — enough to see output, not enough to distract.
// Additional agents spawn as tabs, not panes.
//
// Swap layouts:
//   "default"  — 75/25 vertical split (main + agent sidebar)
//   "solo"     — full screen single pane (deep focus)
//   "dual"     — 50/50 side-by-side (code review / pair)
//
// Vibecrafted with AI Agents (c)2026 Vetcoders
layout {
    // new_tab_template removed: vc-frame 0.44 broke `children` inside it.
    // Chrome lives in session_layer (tagged session_canvas); tab_template
    // and swaps below stay content-only — mirrors native
    // zellij-utils/assets/layouts/vibecrafted.kdl. Screen owns one canvas.
    session_layer {
        pane size=1 borderless=true {
            plugin location="compact-bar" {
                session_canvas true
                session_canvas_kind "compact-bar"
                // 🚥 zone: clear the macOS traffic lights in the native window
                left_inset "6"
            }
        }
        pane split_direction="vertical" {
            pane size=24 borderless=true {
                plugin location="session-manager" {
                    session_canvas true
                    session_canvas_kind "session-manager"
                    rail true
                    pane_title "Sessions"
                }
            }
            pane { children; }
        }
        pane size=1 borderless=true {
            plugin location="status-bar" {
                session_canvas true
                session_canvas_kind "status-bar"
            }
        }
    }

    // Content-only. The parser mounts this inside session_layer without
    // copying chrome ownership into the tab contract.
    default_tab_template {
        pane { children; }
    }

    tab name="𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. Workflow" {
        pane split_direction="vertical" {
            pane name="main" size="75%" focus=true command="zsh"
            pane name="agent" size="25%" command="zsh"
        }
    }

    // Swap: solo — full screen deep focus
    swap_tiled_layout name="solo" {
        tab {
            pane name="main" focus=true
        }
    }

    // Swap: dual — 50/50 side by side
    swap_tiled_layout name="dual" {
        tab {
            pane split_direction="vertical" {
                pane name="main" size="50%" focus=true command="zsh"
                pane name="agent" size="50%" command="zsh"
            }
        }
    }
}
